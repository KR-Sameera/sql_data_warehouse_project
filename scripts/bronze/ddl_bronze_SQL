/*
===============================================================================
DDL Script: Create Bronze Tables
===============================================================================
Script Purpose:
    This script creates tables in the 'bronze' schema, dropping existing tables 
    first if they already exist (Safe Drop & Create). These tables serve as the 
    landing zone for raw CRM and ERP data ingestion.

Tables Created:
    - CRM Layer:
        * bronze.crm_cust_info
        * bronze.crm_prod_info
        * bronze.crm_sales_details
    - ERP Layer:
        * bronze.erp_loc_a101
        * bronze.erp_cust_az12
        * bronze.erp_px_cat_g1v2

WARNING: 
    Running this script will drop existing tables and clear all raw data within them.
===============================================================================
*/

-- =============================================================================
-- Create Schema (if it doesn't exist)
-- =============================================================================
IF NOT EXISTS (SELECT * FROM sys.schemas WHERE name = 'bronze')
BEGIN
    EXEC('CREATE SCHEMA bronze');
END
GO

-- =============================================================================
-- 1. CRM Customer Info Table
-- =============================================================================
IF OBJECT_ID('bronze.crm_cust_info', 'U') IS NOT NULL
    DROP TABLE bronze.crm_cust_info;
GO

CREATE TABLE bronze.crm_cust_info (
    cst_id INT,
    cst_key VARCHAR(50),
    cst_firstname VARCHAR(50),
    cst_lastname VARCHAR(50),
    cst_material_status VARCHAR(50),
    cst_gndr VARCHAR(50),
    cst_create_date DATE
);
GO

-- =============================================================================
-- 2. CRM Product Info Table
-- =============================================================================
IF OBJECT_ID('bronze.crm_prod_info', 'U') IS NOT NULL
    DROP TABLE bronze.crm_prod_info;
GO

CREATE TABLE bronze.crm_prod_info ( 
    prd_id INT,
    prd_key VARCHAR(50),
    prd_nm VARCHAR(50),
    prd_cost INT,
    prd_line VARCHAR(50),
    prd_start_dt DATETIME,
    prd_end_dt DATETIME
);
GO

-- =============================================================================
-- 3. CRM Sales Details Table
-- =============================================================================
IF OBJECT_ID('bronze.crm_sales_details', 'U') IS NOT NULL
    DROP TABLE bronze.crm_sales_details;
GO

CREATE TABLE bronze.crm_sales_details (
    sls_ord_num VARCHAR(50),
    sls_prod_key VARCHAR(50),
    sls_cust_id INT,
    sls_order_dt INT,
    sls_ship_dt INT,
    sls_due_dt INT,
    sls_sales INT,
    sls_quantity INT,
    sls_price INT
);
GO

-- =============================================================================
-- 4. ERP Location Table (LOC_A101)
-- =============================================================================
IF OBJECT_ID('bronze.erp_loc_a101', 'U') IS NOT NULL
    DROP TABLE bronze.erp_loc_a101;
GO

CREATE TABLE bronze.erp_loc_a101 (
    cid VARCHAR(50),
    cntry VARCHAR(50)
);
GO

-- =============================================================================
-- 5. ERP Customer Table (CUST_AZ12)
-- =============================================================================
IF OBJECT_ID('bronze.erp_cust_az12', 'U') IS NOT NULL
    DROP TABLE bronze.erp_cust_az12;
GO

CREATE TABLE bronze.erp_cust_az12 (
    cid VARCHAR(50),
    bdate DATE,
    gen VARCHAR(50)
);
GO

-- =============================================================================
-- 6. ERP Product Category Table (PX_CAT_G1V2)
-- =============================================================================
IF OBJECT_ID('bronze.erp_px_cat_g1v2', 'U') IS NOT NULL
    DROP TABLE bronze.erp_px_cat_g1v2;
GO

CREATE TABLE bronze.erp_px_cat_g1v2 (
    id VARCHAR(50),
    cat VARCHAR(50),
    subcat VARCHAR(50),
    maintanace VARCHAR(50)
);
GO
